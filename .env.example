# Copy this file to .env and fill in your values.

# Option A: any OpenAI-compatible API. Groq (free tier): LLM_BASE_URL=https://api.groq.com/openai/v1, LLM_MODEL=openai/gpt-oss-120b
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=gsk_your-key-here
LLM_MODEL=gpt-4o-mini

# Option B: free local model with Ollama (install from ollama.com, then: ollama pull llama3.1)
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_API_KEY=ollama
# LLM_MODEL=llama3.1

# Multilingual embedding model (works for German + English)
EMBED_MODEL=intfloat/multilingual-e5-small

# Abstention gate: refuse without calling the LLM if the best chunk's cosine similarity
# is below this. Tune it with `python -m eval.run_eval` (see the "abstention" output).
MIN_DENSE_SCORE=0.83
